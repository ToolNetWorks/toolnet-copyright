# Set these only in .env.local locally or Vercel Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=toolnet-copyright-private
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Email/password account for first admin; do not commit a real hash or secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=generate-with-npm-run-admin:hash
AUTH_SECRET=replace-with-32-plus-random-bytes
NEXT_PUBLIC_SITE_URL=http://localhost:3000
